# Upstox Read-Only Analytics or Access Token (Required for live/test modes)
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Optional Telegram Alert Credentials (if omitted, alerts print to console)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MCX Universe ("ALL" scans every optionable MCX commodity automatically, or e.g. CRUDEOIL,CRUDEOILM,NATURALGAS,GOLDM)
MCX_SYMBOLS=ALL

# Expiry Rollover Rule: roll to next month's expiry when <= 4 or 5 days remain
ROLLOVER_DTE=5

# Strikes scanned around live underlying futures ATM (ATM +/- N strikes)
STRIKES_AROUND_ATM=6

# Pricing & Mispricing Thresholds (BUY-SIDE ONLY)
RISK_FREE_RATE=0.065
MIN_GAP_PCT=5.0
STRONG_GAP_PCT=10.0
HIGH_GAP_PCT=15.0
MIN_GAP_RS=2.0

# Liquidity & Quote Quality Filters
MIN_LTP=5.0
MIN_OI=50
MIN_VOLUME=10
MAX_SPREAD_PCT=5.0
REQUIRE_ASK_CLEARANCE=true

# Polling & Deduplication
POLL_SECONDS=30
ALERT_COOLDOWN_MINUTES=60
